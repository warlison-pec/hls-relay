PORT=8099
LISTEN_HOST=0.0.0.0
POLL_INTERVAL=2
WINDOW_SEGMENTS=14
START_BEHIND_SEGMENTS=5
MAX_CACHE_MB=256
HTTP_TIMEOUT=12
SOURCE_USER_AGENT=BoxServer-HLS-Relay/1.0
SOURCE_REFERER=
